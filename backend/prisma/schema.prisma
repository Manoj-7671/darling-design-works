datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      String    @default("Architect") // Architect, Engineer, Client
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  name         String
  length       Float
  width        Float
  floors       Int         @default(2)
  bedrooms     Int         @default(3)
  bathrooms    Int         @default(3)
  parking      String      @default("1 car")
  style        String      @default("Modern")
  buildingType String      @default("Residential")
  height       Float       @default(10.0)
  location     String      @default("Hyderabad, India")
  budget       Float       @default(55.0)
  prompt       String?
  
  floorPlans   FloorPlan[]
  estimates    Estimate[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model FloorPlan {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level       String   // "GF", "FF", "STACKED"
  roomData    String   // JSON string representing rooms, dimensions & coordinates
  wallHeight  String   @default("low")
  createdAt   DateTime @default(now())
}

model Estimate {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plotAreaSqFt  Float
  builtUpSqFt   Float
  estimatedCost Float
  costPerSqFt   Float    @default(2200.0)
  cementBags    Int
  steelKg       Float
  sandCuFt      Float
  aggregateCuFt Float
  bricksUnits   Int
  tilesSqFt     Float
  status        String   @default("Preliminary")
  createdAt     DateTime @default(now())
}
